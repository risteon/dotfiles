# YAZI shell wrapper to change current working directory when exiting yazi
# https://yazi-rs.github.io/docs/quick-start/
local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
yazi "$@" --cwd-file="$tmp"
if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
	builtin cd -- "$cwd"
fi
rm -f -- "$tmp"
